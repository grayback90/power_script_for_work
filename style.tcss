/* Linke Spalte mit den Skripten. */
#scripts-menu {
    width: 25;
    border: round cyan;
    padding: 1 2;
}

/* Rechte Spalte mit zusätzlichen Funktionen. */
#additional-menu {
    width: 25;
    border: round green;
    padding: 1 2;
}

#log {
    border: round yellow;
    padding: 0 1;
}

/* Das Log nutzt den verfügbaren Platz im Skript-Tab. */
.script-log {
    height: 1fr;
}

/* Die Eingabezeile erhält eine feste Höhe. */
.script-input {
    height: 3;
}


/* Macht die Tab-Leiste etwas höher. */
#script-tabs > Tabs {
    height: 3;
}

/* Vergrößert die einzelnen Tabs. */
#script-tabs > Tabs > Tab {
    height: 3;
    padding: 0 3;
    content-align: center middle;
    text-style: bold;
}

/* Erste Tab-Farbe: Blau. */
#script-tabs Tab.tab-color-blue {
    background: #245477;
    color: white;
}

/* Zweite Tab-Farbe: Türkis. */
#script-tabs Tab.tab-color-teal {
    background: #17665f;
    color: white;
}

/* Aktiver Tab: deutlich hellere Darstellung. */
#script-tabs Tab.-active {
    background: #d49b35;
    color: black;
    text-style: bold;
}

/* Linker Gesamtbereich für die Menüspalten. */
#menu-area {
    width: 50;
}

/* Der Tab-Bereich nutzt den restlichen Platz. */
#script-tabs {
    width: 1fr;
}

/* Obere Menüzeile mit Skripten und Weiteres. */
#menu-area > Horizontal {
    height: 1fr;
}

/* System-Bereich kompakt halten und Inhalt zentrieren. */
#system-menu {
    height: auto;
    min-height: 5;
    max-height: 7;
    border: round yellow;
    padding: 1 2;
    align: center middle;
}

/* Buttons im System-Bereich nicht unnötig verbreitern. */
#system-menu Button {
    width: auto;
}

/* Abstand zwischen den nebeneinanderliegenden Buttons. */
#system-menu Horizontal {
    width: auto;
    height: auto;
    align: center middle;
    padding: 0 1;
    layout: horizontal;
}

#system-menu Horizontal Button {
    margin: 0 1;
}

/* Buttons innerhalb der beiden Menüspalten zentrieren. */
#scripts-menu,
#additional-menu {
    align: center top;
}
